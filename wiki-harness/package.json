{
  "name": "@wiki/harness",
  "version": "0.1.0",
  "description": "轻量级 LLM Agent 运行时，公式 Agent = LLM + Harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('../release/harness','dist',{recursive:true})\"",
    "test": "node --import tsx --test"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0"
  }
}
