{
  "project": {
    "name": "Karpathy-Wiki",
    "root": ".."
  },
  "ports": {
    "api": 3000,
    "web": 5173
  },
  "commands": {
    "pkg_manager": "auto",
    "api_cmd": "dev:api",
    "web_cmd": "dev:web",
    "health_check_path": "/health"
  },
  "process": {
    "api_window_title": "KarpathyWiki-API",
    "web_window_title": "KarpathyWiki-Web",
    "pid_dir": "logs"
  },
  "log": {
    "session_id_prefix": "sess",
    "session_id_format": "yyyyMMddHHmmss",
    "random_hex_length": 4,
    "seq_padding": 3,
    "timestamp_format": "yyyy-MM-dd HH:mm:ss.fff"
  },
  "log_colors": {
    "timestamp": "DarkGray",
    "separator": "DarkGray",
    "session_id": "Cyan",
    "step_tag": "Magenta",
    "message": "White",
    "levels": {
      "INFO": "Green",
      "WARN": "Yellow",
      "ERROR": "Red",
      "STEP": "Cyan",
      "OK": "Green",
      "FAIL": "Red",
      "SKIP": "DarkYellow"
    }
  },
  "startup": {
    "api_wait_max_tries": 15,
    "web_wait_max_tries": 10,
    "ping_interval_seconds": 2,
    "open_browser": true,
    "browser_url": "http://localhost:5173",
    "api_window_mode": "silent",
    "web_window_mode": "silent",
    "api_log_file": "logs/api-dev.log",
    "web_log_file": "logs/web-dev.log"
  },
  "shutdown": {
    "verify_wait_seconds": 1,
    "exit_delay_seconds": 2
  },
  "tauri": {
    "name": "karpathy-wiki-desktop",
    "desktop_dir": "packages/desktop",
    "src_tauri_dir": "packages/desktop/src-tauri",
    "exe_name": "karpathy-wiki-desktop.exe",
    "main_window_title": "Karpathy Wiki",
    "port": 3000,
    "health_check_path": "/health",
    "health_check_max_tries": 120,
    "ping_interval_seconds": 2,
    "log_file": "logs/tauri-dev.log",
    "pid_file": "logs/tauri.pid",
    "dev_script": "dev",
    "build_script": "build",
    "bundle_output_dir": "dist/tauri-bundle"
  },
  "rust": {
    "toolchain": "stable-x86_64-pc-windows-gnu",
    "cargo_bin_env": "USERPROFILE\\.cargo\\bin",
    "rustup_env": "RUSTUP_TOOLCHAIN",
    "rustflags_template": "-C linker={ld_lld} -C linker-flavor=ld.lld -C link-arg=-L{lib1} -C link-arg=-L{lib2} -C link-self-contained=yes"
  },
  "mingw": {
    "root_rel": "..\\w64devkit\\w64devkit",
    "bin_subdir": "bin",
    "lib_subdir": "lib",
    "gcc_lib_subdir": "lib\\gcc\\x86_64-w64-mingw32\\16.1.0",
    "ld_lld_name": "ld.lld.exe",
    "windres_name": "windres.exe"
  },
  "windres_wrapper": {
    "ps1_script": "scripts\\windres-wrapper.ps1",
    "exe_wrapper": "scripts\\windres.exe",
    "env_var_name": "WRAPPER_PS1"
  },
  "disk_space": {
    "debug_min_gb": 3,
    "release_min_gb": 5,
    "warn_threshold_gb": 1
  },
  "encoding": {
    "bat_strategy": "ascii",
    "bat_chcp": "65001",
    "ps1_output_encoding": "UTF8",
    "ps1_bom": true,
    "line_ending": "CRLF"
  }
}
