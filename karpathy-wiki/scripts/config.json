{
  "project": {
    "name": "Karpathy-Wiki",
    "root": ".."
  },
  "ports": {
    "api": 3000,
    "web": 5173
  },
  "commands": {
    "pkg_manager": "auto",
    "api_cmd": "dev:api",
    "web_cmd": "dev:web",
    "health_check_path": "/health"
  },
  "process": {
    "api_window_title": "KarpathyWiki-API",
    "web_window_title": "KarpathyWiki-Web",
    "pid_dir": "logs"
  },
  "log": {
    "session_id_prefix": "sess",
    "session_id_format": "yyyyMMddHHmmss",
    "random_hex_length": 4,
    "seq_padding": 3,
    "timestamp_format": "yyyy-MM-dd HH:mm:ss.fff"
  },
  "log_colors": {
    "timestamp": "DarkGray",
    "separator": "DarkGray",
    "session_id": "Cyan",
    "step_tag": "Magenta",
    "message": "White",
    "levels": {
      "INFO": "Green",
      "WARN": "Yellow",
      "ERROR": "Red",
      "STEP": "Cyan",
      "OK": "Green",
      "FAIL": "Red",
      "SKIP": "DarkYellow"
    }
  },
  "startup": {
    "api_wait_max_tries": 90,
    "web_wait_max_tries": 90,
    "ping_interval_seconds": 2,
    "open_browser": true,
    "browser_url": "http://localhost:5173",
    "api_window_mode": "silent",
    "web_window_mode": "silent",
    "api_log_file": "logs/api-dev.log",
    "web_log_file": "logs/web-dev.log"
  },
  "shutdown": {
    "verify_wait_seconds": 1,
    "exit_delay_seconds": 2
  },
  "tools": {
    "node": {
      "exe_path": "D:\\code\\nodejs24\\node.exe",
      "search_paths": [
        "D:\\code\\nodejs24\\node.exe",
        "C:\\Program Files\\nodejs\\node.exe",
        "C:\\Program Files (x86)\\nodejs\\node.exe"
      ],
      "use_path_fallback": true,
      "min_version": [18, 0]
    }
  },
  "publish": {
    "build_args": ["--filter", "@karpathy-wiki/web", "build"],
    "deploy_src": "../release/spa/public",
    "deploy_script": "api/_deploy_live.mjs",
    "prod_start_args": ["--filter", "@karpathy-wiki/api", "exec", "--", "tsx", "src/index.ts"],
    "prod_log_file": "logs/publish-prod.log",
    "build_log_file": "logs/publish-build.log",
    "health_path": "/health",
    "spa_probe_path": "/wiki/",
    "wait_max_tries": 90,
    "ping_interval_seconds": 2,
    "release_asset_glob": "../release/installer/KarpathyWiki-Setup-v*.exe",
    "release_notes_prefix": "release-notes-",
    "version_source": "package.json",
    "python_candidates": ["python", "python3", "py"]
  }
}
