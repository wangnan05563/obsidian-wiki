# ============================================================================
# karpathy-wiki 项目级 .gitignore
# 只写「本项目特有」规则；通用产物（node_modules/dist/build/coverage/
# .scannerwork/.harness/*.log/临时脚本/IDE 与系统垃圾/凭据文件形态）
# 已由仓库根 .gitignore 统一覆盖，此处不再重复。
# ============================================================================

# ---------- 环境与敏感配置 ----------
# config.json 含 apiKey 等实密钥，仅本地保留；example 文件作为模板提交
api/config.json
!api/config.example.json

# ---------- 构建产物 ----------
# esbuild/pkg 的中间构建目录（bundle.cjs、patch-counter.json、热更就绪标记），
# 每次构建重建；曾出现在 .build/ 与 api/.build/ 两处
.build/
# vite 构建产物（build-web.bat 输出）：api/public/ 为部署快照，整体忽略
# （api/dist/、frontend/dist/ 由根规则的 dist/ 覆盖，此处不重复）
api/public/
# 本机构建/调试临时目录
.tmp-*
# vite 构建/配置临时生成的 timestamp 中间文件
*.config.mjs.timestamp-*.mjs
*.config.ts.timestamp-*.mjs

# ---------- TypeScript / vue-tsc 编译产物 ----------
# vue-tsc 生成的虚拟代码文件，不应提交或扫描
*.vue.js
# TypeScript 编译产物（vue-tsc/tsc 输出），源码目录下不应存在 .js
frontend/src/**/*.js

# ---------- 运行时数据（data/） ----------
# 【出仓决定 2026-10-30】data/vault/ 整体不再入库。
# 这里是知识库的运行时内容（AI 编译产出的 concepts/comparisons/drafts/qa 页面、
# QQ 导入生成的草稿、raw/ 原始输入、log.md/index.md 操作日志），既含内部业务资料，
# 又每次编译都在变——把它提交进公开仓库既泄露面大，也让 diff 长期被内容噪声淹没。
# 唯一保留的是 data/vault/SCHEMA.md：它是目录结构/字段规范的说明文档（属于产品约定，
# 不是知识内容），vault-service.ts 的注释还引用它作为口径来源。
#
# 写法必须用 `data/vault/*` + 反向排除，而不是 `data/vault/`：git 一旦忽略目录本身，
# 就不会再进目录匹配任何 `!` 规则，SCHEMA.md 的保留会静默失效。
# 副作用：新克隆的仓库没有 vault 目录，首次启动由后端按 config.vaultPath 自建。
data/vault/*
!data/vault/SCHEMA.md
# 历史会话运行时数据（后端持久化，含用户问答内容，敏感不提交）
data/conversations/
# 线程隔离的本地会话/记忆运行时数据（data/threads/{id}/ 含 session.json/memory.json，同属敏感问答内容）
data/threads/
# 会话本地化迁移的一次性备份目录（scripts/migrate-sessions-local.mjs 产出），
# 内容与被忽略的 data/conversations/ 同源（用户问答记录），同属敏感数据不入库；
# 磁盘副本保留作回滚用
data/_migrated_local_*/
# 同类一次性快照（raw 迁移前的 vault 备份 _vault_backup_pre_rawmig_*，历史中曾误入库 107 个文件）：
# 规则先行补齐以防复发，目录本身已不在磁盘上
data/_vault_backup_*/
# 技能导入运行时数据（用户上传的 .skill/.md 解压后存储，含外部资源不提交）
data/skills/
# 5.1.3 URL 爬取增量状态文件（运行时生成，含站点 URL 与 ETag，不入版本控制）
data/url-crawl-state.json
data/url-crawl.log
# 隧道工具二进制：tunnel-service.ts 的 ensureBinary() 会按官方 release 三源自愈下载
# （cloudflared 走 GitHub/ghfast/固定版本，cpolar 走 zip 下载 + tar 解压），
# 54MB + 19MB 的可再生外部二进制不入库
data/cloudflared.exe
data/cpolar.exe
# 鉴权用户存储：含 passwordHash/salt，属凭据材料。文件缺失时 user-store.ts
# 自动 bootstrap 默认账户并告警改密；结构说明见已提交的 data/users.example.json
data/users.json
# 同名旧位置副本：早期以 cwd=api 启动时写下的 users.json/audit.log 残留，
# 现运行时路径由 utils/runtime.ts 统一解析为 karpathy-wiki/data，此处仅为历史遗留
api/data/
# SQLite 混合检索索引库及其 WAL/SHM 伴生文件（sqlite-index.ts 在 dataDir 自建，
# 可经 FR-20 重建端点全量重建）
data/wiki-index.db
data/wiki-index.db-shm
data/wiki-index.db-wal
# 审计日志：此前仅被根 .gitignore 的通配 *.log 顺带兜住，通配一旦收窄即漏防，故显式声明
data/audit.log
# data 目录下的 0 字节历史残留（应用实际读取 api/config.json，此文件是无用残留）
data/config.json

# ---------- 一次性脚本与测试证据 ----------
# 测试截图与一次性测试脚本
scripts/test_screenshots/
scripts/test_*.ps1
scripts/test-*.ps1
scripts/test_*.py
scripts/test_report.json
# 历史验收脚本（一次性使用，不应入库）
scripts/sprint*-acceptance.py
# UI 验证脚本（调试用）
scripts/ui-verify-*.py
scripts/measure.py
scripts/verify_ui.py
# 测试证据与截图（本轮 UI 实测的截图/JSON 留存，体积大且可重跑）
docs/test-evidence/
# 前端根目录的一次性调试截图（历史误入库：graph_after_fix.png / graph_head_check.png /
# verify-graph-fixed.png）。正式图片请放 frontend/public/images/ 或 assets/，不受此规则影响
frontend/*.png

# ---------- 根目录运行时日志 ----------
# sprint 阶段 stdout 输出
sprint*-stdout.log
# 本地运行日志与 PID（logs/ 目录本体由根规则忽略，此处覆盖项目内命名变体）
logs/*.out
logs/*.err

# 本地密钥与环境变量（GH_TOKEN 等绝不入库，create-bat T66）；.env.example 模板允许提交
.env
.env.local
.env.*.local
!.env.example
