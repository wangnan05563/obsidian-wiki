# ---------- 环境与依赖 ----------
.env
node_modules/
# config.json 含敏感字段（apiKey 等），仅本地保留；example 文件作为模板提交
api/config.json
!api/config.example.json

# ---------- 构建产物 ----------
dist/
build/
api/dist/
# vite 构建产物（build-web.bat 输出），完整忽略 public/ 目录
api/public/

# ---------- 缓存目录（可重建） ----------
.cache/
.scannerwork/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
.harness/

# ---------- SonarQube 调试日志 ----------
sonar-scan-*.log

# ---------- 测试截图与一次性测试脚本 ----------
scripts/test_screenshots/
scripts/test_*.ps1
scripts/test_*.py
scripts/test_report.json

# ---------- TypeScript / vue-tsc 编译产物 ----------
# vue-tsc 生成的虚拟代码文件，不应提交或扫描
*.vue.js
# TypeScript 编译产物（vue-tsc/tsc 输出），源码目录下不应存在 .js
frontend/src/**/*.js

# ---------- 运行时数据 ----------
# vault 迁至 karpathy-wiki/data/vault/，仅保留 concepts/comparisons/SCHEMA.md 作为种子入库
# raw/（原始输入）、entities/queries/（运行时生成）、log.md（操作日志）、index.md（运行时追加）均忽略
data/vault/raw/
data/vault/entities/
data/vault/queries/
data/vault/log.md
data/vault/index.md
data/vault/.harness/
# 历史会话运行时数据（后端持久化，含用户问答内容，敏感不提交）
data/conversations/

# ---------- 运行时日志与 PID 文件 ----------
logs/*.pid
logs/*.log
logs/*.out
logs/*.err

# ---------- 调试脚本与构建临时文件 ----------
.build/
.tmp-*
scripts/measure.py
scripts/verify_ui.py

# ---------- 测试证据与截图 ----------
docs/test-evidence/
