# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tsbuildinfo
# 构建缓存残留目录（非标准产物，任意层级均忽略，防止误入仓）
**/.npmcache/
# SPA 部署产物（按时间戳的 public_live_* 与前端构建输出 builds/，仅运行时/部署用，不入仓）
# 用 **/ 覆盖任意深度：真实路径为 karpathy-wiki/api/public_live_* 与 karpathy-wiki/frontend/builds/
**/public_live_*/
**/builds/
# 统一发布目录（所有编译/打包产物集中于此：spa/app/installer/harness/builds，不入仓）
release/

# 环境变量与密钥（切勿提交）
.env
.env.local
.env.*.local

# 运行时状态（harness 执行状态文件，属本地运行产物，任意层级）
**/.harness/state/

# 日志
*.log
logs/

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 测试运行时产物（截图、临时结果）
test_buttons_result.json
test_result.json

# Python 编译产物
__pycache__/
*.py[cod]
*.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
